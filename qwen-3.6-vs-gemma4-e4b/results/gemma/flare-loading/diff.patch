@@ -100,8 +100,31 @@ table{width:100%;border-collapse:collapse;font:15px/1.45 var(--sans);margin:26px
 <script>
 const qualities=["low","medium","high","xhigh","max"];
 const portrait=q=>"images/portrait-"+q+".avif";
-document.querySelectorAll("[data-q]").forEach(button=>button.addEventListener("click",()=>{const q=button.dataset.q;document.querySelectorAll("[data-q]").forEach(b=>b.setAttribute("aria-pressed",String(b===button)));["portrait-full","portrait-face","portrait-eye"].forEach(id=>{const img=document.getElementById(id);img.src=portrait(q);img.alt=q+" quality portrait detail"});history.replaceState(null,"","#where-it-shows?quality="+q)}));
-const initial=new URLSearchParams(location.hash.split("?")[1]||"").get("quality");if(qualities.includes(initial))document.querySelector('[data-q="'+initial+'"]')?.click();
-const root=document.documentElement;document.getElementById("theme").addEventListener("click",()=>{root.classList.toggle("light");localStorage.setItem("flare-theme",root.classList.contains("light")?"light":"dark")});if(localStorage.getItem("flare-theme")==="light")root.classList.add("light");
+const updateView = (q, isDynamic = false) => {
+  document.querySelectorAll("[data-q]").forEach(b => b.setAttribute("aria-pressed", String(b.dataset.q === q)));
+  ["portrait-full","portrait-face","portrait-eye"].forEach(id => {
+    const img = document.getElementById(id);
+    if (img) {
+      img.src = portrait(q);
+      img.alt = `${q} quality portrait detail`;
+    }
+  });
+  if (isDynamic) {
+    history.replaceState(null, "", `#where-it-shows?quality=${q}`);
+  }
+};
+
+document.querySelectorAll("[data-q]").forEach(button => button.addEventListener("click", () => {
+  const q=button.dataset.q;
+  updateView(q, true);
+}));
+
+const initial=new URLSearchParams(location.hash.split("?")[1]||"").get("quality");
+if(qualities.includes(initial)) {
+  updateView(initial, false);
+}
+
+const root=document.documentElement;document.getElementById("theme").addEventListener("click",()=>{root.classList.toggle("light");localStorage.setItem("flare-theme",root.classList.contains("light")?"light":"dark")});
+if(localStorage.getItem("flare-theme")==="light")root.classList.add("light");
 </script>
 </body></html>
