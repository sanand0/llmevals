+# ---- backup JSONL validation ----
+
+_BACKUP_CONVERSATION_KEYS = {"conversationId", "conversationTitle"}
+
+
+def _expected_ids_for_path(path: Path) -> tuple[str, str]:
+    """Derive the conversation id and title from a backup filename.
+
+    Expected format: ``{title} [{id}].jsonl`` or ``{title}.jsonl``.
+    Returns ``(conversation_id, title)`` – ``conversation_id`` is empty for
+    files that do not contain an id in square brackets.
+    """
+    stem = path.stem  # strip .jsonl or .json
+    bracket_match = re.search(r"\[([^\]]+)\]$", stem)
+    if bracket_match:
+        return bracket_match.group(1), stem[: bracket_match.start()].strip()
+    # No bracket — title is the whole stem
+    return "", stem
+
+
+def validate_backup_jsonl(
+    path: Path,
+    expected_conversation_id: str = "",
+    expected_title: str = "",
+) -> list[dict[str, Any]]:
+    """Validate a single backup JSONL file.
+
+    Returns a list of error dicts.  Each dict has keys::
+
+        file  – absolute path string
+        line  – 1-based line number
+        error – short machine-readable error code
+        detail – human-readable message (never message text)
+
+    ``expected_conversation_id`` and ``expected_title`` are used to verify
+    that every row's ``conversationId`` / ``conversationTitle`` fields are
+    consistent with the file's identity.  Empty strings mean "skip this
+    check" (e.g. for files not yet tied to a conversation).
+    """
+    errors: list[dict[str, Any]] = []
+    if not path.exists():
+        return errors
+
+    expected_id = expected_conversation_id.strip()
+    expected_title = expected_title.strip()
+    abs_path = str(path.resolve())
+
+    with open(path, "r", encoding="utf-8") as fh:
+        for lineno, raw_line in enumerate(fh, 1):
+            line = raw_line.strip()
+            if not line:
+                continue
+            try:
+                row = json.loads(line)
+            except json.JSONDecodeError as exc:
+                errors.append(
+                    {
+                        "file": abs_path,
+                        "line": lineno,
+                        "error": "json-parse-error",
+                        "detail": f"line {lineno}: {exc.msg}",
+                    }
+                )
+                continue
+            if not isinstance(row, dict):
+                errors.append(
+                    {
+                        "file": abs_path,
+                        "line": lineno,
+                        "error": "not-object",
+                        "detail": f"line {lineno}: expected JSON object, got {type(row).__name__}",
+                    }
+                )
+                continue
+            # Cross-check conversation identity fields (when we have expectations)
+            row_id = str(row.get("conversationId") or "")
+            row_title = str(row.get("conversationTitle") or "")
+            if expected_id and row_id and row_id != expected_id:
+                errors.append(
+                    {
+                        "file": abs_path,
+                        "line": lineno,
+                        "error": "conversation-id-mismatch",
+                        "detail": f"line {lineno}: expected conversationId={obs.short_hash(expected_id)}, got {obs.short_hash(row_id)}",
+                    }
+                )
+            if expected_title and row_title and row_title != expected_title:
+                errors.append(
+                    {
+                        "file": abs_path,
+                        "line": lineno,
+                        "error": "conversation-title-mismatch",
+                        "detail": f"line {lineno}: expected title={obs.short_hash(expected_title)}, got {obs.short_hash(row_title)}",
+                    }
+                )
+    return errors
+
+
