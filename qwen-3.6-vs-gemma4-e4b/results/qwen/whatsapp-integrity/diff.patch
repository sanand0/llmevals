+def test_validate_json_parse_error_identifies_line_and_file(tmp_path: Path) -> None:
+    path = tmp_path / "Chat [abc@g.us].jsonl"
+    path.write_text('{"messageId":"m1","time":"2026-01-01T00:00:00Z"}\n')
+    path.write_text("not json at all\n", "a")
