+    elif (match := re.search(r"\[([^\[\]]+)\]$", path.stem)) and row["conversationId"] != match[1]:
+        problem = "conversationId does not match the destination filename"
+    if problem:
+        raise ValueError(f"Invalid backup JSONL at {path}:{number}: {problem}")
+
