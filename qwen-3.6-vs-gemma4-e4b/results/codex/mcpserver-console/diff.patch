+def test_console_tool_request_truncates_long_details(monkeypatch, capsys) -> None:
+    monkeypatch.setattr(mcpserver, "CONSOLE_RESPONSE_CHARS", 100)
+    command = "HEAD-" + ("x" * 500) + "-TAIL"
+
+    mcpserver.console_tool_request("bash", {"commands": command, "cwd": "/tmp"})
+
+    console = capsys.readouterr().err
+    assert "▶ bash" in console
+    assert "HEAD-" in console and "-TAIL" in console
+    assert "chars omitted" in console
+    assert command not in console
