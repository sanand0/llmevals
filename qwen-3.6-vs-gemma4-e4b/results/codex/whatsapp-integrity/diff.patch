+def validate_backup_files() -> list[str]:
+    """Return safe, line-specific problems in existing conversation backups."""
+    problems = []
+    for path in sorted(OUT_DIR.glob("*.jsonl")):
+        match = re.search(r" \[([^\[\]]+)\]$", path.stem)
+        expected_id = match.group(1) if match else None
+        with path.open("rb") as handle:
+            for line_number, raw_line in enumerate(handle, 1):
+                if not raw_line.strip():
+                    continue
+                try:
+                    line = raw_line.decode("utf-8")
+                    row = json.loads(line, parse_constant=lambda _: (_ for _ in ()).throw(ValueError()))
+                except (UnicodeDecodeError, json.JSONDecodeError, ValueError):
+                    problems.append(f"{path}:{line_number}: malformed JSON")
+                    continue
+                if not isinstance(row, dict):
+                    problems.append(f"{path}:{line_number}: row is not a JSON object")
+                elif expected_id and row.get("conversationId") != expected_id:
+                    problems.append(f"{path}:{line_number}: conversationId does not match filename")
+    return problems
+
+
+def require_valid_backup_files() -> None:
+    problems = validate_backup_files()
+    if problems:
+        raise ValueError("invalid backup JSONL files:\n" + "\n".join(problems))
+
