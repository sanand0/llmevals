+def test_main_rejects_corrupt_backups_before_running_cdp(tmp_path: Path, monkeypatch) -> None:
+    from typer.testing import CliRunner
+
+    out_dir = tmp_path / "backups"
+    out_dir.mkdir()
+    bad_a = out_dir / "A [a@g.us].jsonl"
+    bad_b = out_dir / "B [b@g.us].jsonl"
+    bad_a.write_text('broken private message\n')
+    bad_b.write_text('{"conversationId":"wrong@g.us","text":"private secret"}\n')
+    scraper = tmp_path / "scraper.js"
+    scraper.write_text("")
+    before = (bad_a.read_bytes(), bad_b.read_bytes())
+
+    def must_not_connect(*args, **kwargs):
+        raise AssertionError("backup run started before validation")
+
+    monkeypatch.setattr(backup.asyncio, "run", must_not_connect)
+    result = CliRunner().invoke(backup.app, ["--out-dir", str(out_dir), "--scraper", str(scraper)])
+
+    assert result.exit_code == 1
+    assert f"{bad_a}:1: malformed JSON" in result.output
+    assert f"{bad_b}:1: conversationId does not match filename" in result.output
+    assert "private message" not in result.output
+    assert "private secret" not in result.output
+    assert (bad_a.read_bytes(), bad_b.read_bytes()) == before
