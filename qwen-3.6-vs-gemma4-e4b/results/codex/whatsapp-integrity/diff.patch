+def test_validate_backup_files_reports_all_errors_without_message_text(tmp_path: Path, monkeypatch) -> None:
+    monkeypatch.setattr(backup, "OUT_DIR", tmp_path)
+    first = tmp_path / "Family [123@g.us].jsonl"
+    second = tmp_path / "Work [456@g.us].jsonl"
+    first.write_bytes(b'{"conversationId":"123@g.us","text":"private secret"}\nnot json\n\xff\n')
+    second.write_text('{"conversationId":"wrong@g.us","text":"another private secret"}\n')
+    before = {path: path.read_bytes() for path in (first, second)}
+
+    problems = backup.validate_backup_files()
+
+    assert len(problems) == 3
+    assert f"{first}:2: malformed JSON" in problems
+    assert f"{first}:3: malformed JSON" in problems
+    assert f"{second}:1: conversationId does not match filename" in problems
+    assert "private secret" not in "\n".join(problems)
+    assert {path: path.read_bytes() for path in (first, second)} == before
+
